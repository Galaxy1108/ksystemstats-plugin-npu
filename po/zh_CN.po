#: NpuPlugin.cpp
msgctxt "@title"
msgid "NPU"
msgstr "NPU"

#: NpuPlugin.cpp
msgctxt "@title"
msgid "Utilization"
msgstr "利用率"

#: NpuPlugin.cpp
msgctxt "@info"
msgid ""
"Time the NPU spent executing jobs, as a percentage of the sampling "
"interval."
msgstr "在采样区间内，NPU 执行任务所占的时间比例。"

#: NpuPlugin.cpp
msgctxt "@title"
msgid "Intel NPU %1"
msgstr "Intel NPU %1"

#: NpuPlugin.cpp
msgctxt "@title"
msgid "Frequency"
msgstr "频率"

#: NpuPlugin.cpp
msgctxt "@title"
msgid "Minimum Frequency"
msgstr "最低频率"

#: NpuPlugin.cpp
msgctxt "@title"
msgid "Efficient Frequency"
msgstr "能效频率"

#: NpuPlugin.cpp
msgctxt "@title"
msgid "Maximum Frequency"
msgstr "最高频率"

#: NpuPlugin.cpp
msgctxt "@title"
msgid "Memory"
msgstr "内存"

#: NpuPlugin.cpp
msgctxt "@title"
msgid "Scheduler Mode"
msgstr "调度模式"

#: NpuPlugin.cpp
msgctxt "@title"
msgid "Power State"
msgstr "电源状态"

#: NpuPlugin.cpp
msgctxt "@title"
msgid "Temperature"
msgstr "温度"

#: NpuPlugin.cpp
msgctxt "@info"
msgid "NPU temperature reported through Intel PMT telemetry."
msgstr "通过 Intel PMT 遥测读取的 NPU 温度。"

#: NpuPlugin.cpp
msgctxt "@title"
msgid "Power"
msgstr "功耗"

#: NpuPlugin.cpp
msgctxt "@info"
msgid "NPU power consumption, derived from the PMT energy counter."
msgstr "NPU 功耗，由 PMT 能量计数器差分计算得出。"

#: NpuPlugin.cpp
msgctxt "@title"
msgid "Voltage (raw)"
msgstr "电压（原始值）"

#: NpuPlugin.cpp
msgctxt "@info"
msgid "Raw PMT voltage field. No public conversion to volts is documented."
msgstr "PMT 原始电压字段，没有公开的伏特换算关系。"
